# Global Integration Environment Configuration

# Ports
PORT=8000
FRONTEND_PORT=5173
AIRFLOW_PORT=8080

# Application Database (shared Postgres)
DATABASE_URL=postgresql://civic_user:civic_pass@postgres:5432/civic_pipeline
POSTGRES_DB=civic_pipeline
POSTGRES_USER=civic_user
POSTGRES_PASSWORD=civic_pass

# Airflow Database
AIRFLOW_DATABASE_URL=postgresql+psycopg2://airflow:airflow@airflow-postgres:5432/airflow_db

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Frontend Configuration
VITE_API_BASE_URL=/api
VITE_WS_URL=ws://localhost:5173/ws/alerts

# Spark Correlator Configuration
POSTGRES_JDBC_URL=jdbc:postgresql://postgres:5432/civic_pipeline
MIN_TRUST_THRESHOLD=0.6

# Airflow Maintenance DAG
APP_DB_HOST=postgres
APP_DB_PORT=5432
APP_DB_NAME=civic_pipeline
APP_DB_USER=civic_user
APP_DB_PASS=civic_pass
ARCHIVE_DIR=/opt/airflow/archives

# Ambient Simulator
BACKEND_SIMULATE_URL=http://backend:8000/api/simulate
INTERVAL_SECONDS=35
